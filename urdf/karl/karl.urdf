<?xml version="1.0"?>
<!--
  Vehicle description of karl.

  The source of truth for this file is the robot_state_publisher URDF in the
  karl-platform repository (essentials/robot_state_publisher/karl.urdf).
  Sensor calibrations there change over time. When new bag files are recorded
  with an updated karl-platform URDF, update this asset to match, so that
  simulation and bag replay use the same frames and transforms as the recordings.
  Last synced with karl-platform on 2026-11-25.

  The base_footprint frame (ground projection of base_link, without roll and
  pitch) is not part of this URDF. It is published by the ego state estimation
  as a child of base_link.
-->
<robot name="karl">

  <!-- VEHICLE FRAMES ====================================================== -->

  <link name="base_link"> <!-- middle (y) of rear axle (x,z) -->
    <visual>
      <origin xyz="0 0 -0.32" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///mesh/karl/karl.obj" />
      </geometry>
    </visual>
  </link>

  <link name="geometric_center"/>
  <joint name="base_link_2_geometric_center" type="fixed">
    <parent link="base_link" />
    <child link="geometric_center" />
    <origin xyz="1.4895 0 0.635" rpy="0 0 0" />
  </joint>

  <!-- RADARS ============================================================== -->

  <!-- smartmicro_radar/front_left -->
  <link name="drivers/smartmicro_radar/front_left"/>
  <joint name="drivers/smartmicro_radar/front_left" type="fixed">
    <parent link="base_link" />
    <child link="drivers/smartmicro_radar/front_left" />
    <origin xyz="3.54 0.86 0.41" rpy="0.02812724703084657 0.025740076302237642 1.5834881957956424" />
  </joint>

  <!-- smartmicro_radar/front_right -->
  <link name="drivers/smartmicro_radar/front_right"/>
  <joint name="drivers/smartmicro_radar/front_right" type="fixed">
    <parent link="base_link" />
    <child link="drivers/smartmicro_radar/front_right" />
    <origin xyz="3.54 -0.86 0.41" rpy="-0.0281272470310986 -0.025740076301962223 -1.5581044577843584" />
  </joint>

  <!-- smartmicro_radar/rear_left -->
  <link name="drivers/smartmicro_radar/rear_left"/>
  <joint name="drivers/smartmicro_radar/rear_left" type="fixed">
    <parent link="base_link" />
    <child link="drivers/smartmicro_radar/rear_left" />
    <origin xyz="-1.0247773749193776 0.906941604969068 0.93413892825" rpy="0.037994168279677845 -0.006972935763300544 2.5819178987472088" />
  </joint>

  <!-- smartmicro_radar/rear_right -->
  <link name="drivers/smartmicro_radar/rear_right"/>
  <joint name="drivers/smartmicro_radar/rear_right" type="fixed">
    <parent link="base_link" />
    <child link="drivers/smartmicro_radar/rear_right" />
    <origin xyz="-0.8673819186404179 -0.8752521474996037 1.07825536017" rpy="0.00414605394886724 -0.03776700239450548 -2.5575583452731842" />
  </joint>

  <!-- altos_radar -->
  <link name="altos_radar"/>
  <joint name="drivers/altos_radar/center" type="fixed">
    <parent link="base_link" />
    <child link="altos_radar" />
    <origin xyz="3.9384885445959754 -0.26471563689009103 0.16646635941" rpy="0.007555071332938296 0.02694165889091016 0.0031244566285781082" />
  </joint>

  <!-- RACK ================================================================ -->

  <link name="rack"> <!-- rear (x) right (y) bottom (z) corner of sensor rack -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///mesh/karl/rack.obj" />
      </geometry>
    </visual>
  </link>
  <joint name="base_link_2_rack" type="fixed">
    <parent link="base_link" />
    <child link="rack" />
    <origin xyz="-0.636 -0.695 1.590" rpy="-0.025750257186693076 0.028117927213501016 0.011967760624783476" />
  </joint>

  <!-- LIDARS ============================================================== -->

  <!-- aeva_lidar -->
  <link name="drivers/aeva_lidar/front_left_screw_bottom"/>
  <link name="aeva/aeries2/sensor"/> <!-- point cloud frame -->
  <link name="aeva/vehicle"/> <!-- detections frame -->
  <joint name="rack_2_drivers/aeva_lidar/front_left_screw_bottom" type="fixed">
    <parent link="rack" />
    <child link="drivers/aeva_lidar/front_left_screw_bottom" />
    <origin xyz="2.9152655658441593 0.6354418638255341 0.2285386481567877" rpy="0.023679138459782593 -0.02331588425531329 0.006883128047870786" />
  </joint>
  <joint name="drivers/aeva_lidar/front_left_screw_bottom_2_aeva/aeries2/sensor" type="fixed">
    <parent link="drivers/aeva_lidar/front_left_screw_bottom" />
    <child link="aeva/aeries2/sensor" />
    <!-- <origin xyz="-0.04010 -0.08445 0.06135" rpy="0.0 0.0 0.0" /> from aeva -->
    <origin xyz="-0.04010 -0.08445 0.06135" rpy="0.0 0.0 -0.03" /> <!-- manual calibration to other lidars -->
  </joint>
  <joint name="drivers/aeva_lidar/front_left_screw_bottom_2_aeva_vehicle" type="fixed">
    <parent link="drivers/aeva_lidar/front_left_screw_bottom" />
    <child link="aeva/vehicle" />
    <origin xyz="-0.04010 -0.08445 0.06135" rpy="0.0 0.0 0.0" /> <!-- from aeva -->
  </joint>

  <!-- ouster_lidar/front_left -->
  <link name="drivers/ouster_lidar_fl/sensor"/>
  <link name="drivers/ouster_lidar_fl/lidar"/>
  <joint name="drivers/ouster_lidar/ouster_lidar_fl/sensor" type="fixed">
    <parent link="rack" />
    <child link="drivers/ouster_lidar_fl/sensor" />
    <origin xyz="2.9134303399949544 1.2491920806439114 0.18748632540872734" rpy="0.007660475974114942 0.32058125218440064 0.7887678541023947" />
  </joint>
  <joint name="drivers/ouster_lidar_fl/sensor_2_drivers/ouster_lidar_fl/lidar" type="fixed">
    <parent link="drivers/ouster_lidar_fl/sensor" />
    <child link="drivers/ouster_lidar_fl/lidar" />
    <origin xyz="0.0 0.0 0.038" rpy="0.0 0.0 3.141593" /> <!-- from ouster -->
  </joint>

  <!-- ouster_lidar/front_right -->
  <link name="drivers/ouster_lidar_fr/sensor"/>
  <link name="drivers/ouster_lidar_fr/lidar"/>
  <joint name="drivers/ouster_lidar/ouster_lidar_fr/sensor" type="fixed">
    <parent link="rack" />
    <child link="drivers/ouster_lidar_fr/sensor" />
    <origin xyz="2.9220711461395785 -0.14191199819939648 0.15285783701673905" rpy="0.026921706921566594 0.3527433819822571 -0.7780370481273557" />
  </joint>
  <joint name="drivers/ouster_lidar_fr/sensor_2_drivers/ouster_lidar_fr/lidar" type="fixed">
    <parent link="drivers/ouster_lidar_fr/sensor" />
    <child link="drivers/ouster_lidar_fr/lidar" />
    <origin xyz="0.0 0.0 0.038" rpy="0.0 0.0 3.141593" /> <!-- from ouster -->
  </joint>

  <!-- ouster_lidar/rear_left -->
  <link name="drivers/ouster_lidar_rl/sensor"/>
  <link name="drivers/ouster_lidar_rl/lidar"/>
  <joint name="drivers/ouster_lidar/ouster_lidar_rl/sensor" type="fixed">
    <parent link="rack" />
    <child link="drivers/ouster_lidar_rl/sensor" />
    <origin xyz="0.036561930418244404 1.2391193185646345 0.13044972349871808" rpy="-0.04436134119340981 0.35061096658307084 2.337885405122306" />
  </joint>
  <joint name="drivers/ouster_lidar_rl/sensor_2_drivers/ouster_lidar_rl/lidar" type="fixed">
    <parent link="drivers/ouster_lidar_rl/sensor" />
    <child link="drivers/ouster_lidar_rl/lidar" />
    <origin xyz="0.0 0.0 0.038" rpy="0.0 0.0 3.141593" /> <!-- from ouster -->
  </joint>

  <!-- ouster_lidar/rear_right -->
  <link name="drivers/ouster_lidar_rr/sensor"/>
  <link name="drivers/ouster_lidar_rr/lidar"/>
  <joint name="drivers/ouster_lidar/ouster_lidar_rr/sensor" type="fixed">
    <parent link="rack" />
    <child link="drivers/ouster_lidar_rr/sensor" />
    <origin xyz="0.04 -0.1495 0.10" rpy="0.0 0.3759048005725428 -2.35619" />
  </joint>
  <joint name="drivers/ouster_lidar_rr/sensor_2_drivers/ouster_lidar_rr/lidar" type="fixed">
    <parent link="drivers/ouster_lidar_rr/sensor" />
    <child link="drivers/ouster_lidar_rr/lidar" />
    <origin xyz="0.0 0.0 0.038" rpy="0.0 0.0 3.141593" /> <!-- from ouster -->
  </joint>

  <!-- CAMERAS ============================================================= -->

  <!-- zed_camera/front_left -->
  <link name="front_left_left_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_fl_lidar_to_front_left_left_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_fl/lidar" />
    <child link="front_left_left_camera_optical_frame" />
    <origin xyz="-0.026148 -0.047664 -0.165388" rpy="-1.306579 0.001660 1.573094" />
  </joint>
  <link name="front_left_right_camera_optical_frame"/>
  <joint name="front_left_left_to_right_camera_optical_frame" type="fixed">
    <parent link="front_left_left_camera_optical_frame" />
    <child link="front_left_right_camera_optical_frame" />
    <origin xyz="0.120048 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file front-left.conf -->
  </joint>

  <!-- zed_camera/front_center -->
  <link name="front_center_left_camera_optical_frame"/>
  <joint name="joint_aeva_aeries2_sensor_to_front_center_left_camera_optical_frame" type="fixed">
    <parent link="aeva/aeries2/sensor" />
    <child link="front_center_left_camera_optical_frame" />
    <origin xyz="0.114443 -0.013468 -0.229590" rpy="-1.673648 0.003176 -1.543337" />
  </joint>
  <link name="front_center_right_camera_optical_frame"/>
  <joint name="front_center_left_to_right_camera_optical_frame" type="fixed">
    <parent link="front_center_left_camera_optical_frame" />
    <child link="front_center_right_camera_optical_frame" />
    <origin xyz="0.120068 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file front-center.conf -->
  </joint>

  <!-- zed_camera/front_right -->
  <link name="front_right_left_camera_optical_frame"/>
  <joint name="front_right_right_to_left_camera_optical_frame" type="fixed">
    <parent link="front_right_right_camera_optical_frame" />
    <child link="front_right_left_camera_optical_frame" />
    <origin xyz="-0.120014 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file front-right.conf -->
  </joint>
  <link name="front_right_right_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_fr_lidar_to_front_right_right_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_fr/lidar" />
    <child link="front_right_right_camera_optical_frame" />
    <origin xyz="0.030412 0.053351 -0.105009" rpy="-1.321942 -0.000088 1.577377" />
  </joint>

  <!-- zed_camera/mid_left -->
  <link name="mid_left_left_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_fl_lidar_to_mid_left_left_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_fl/lidar" />
    <child link="mid_left_left_camera_optical_frame" />
    <origin xyz="0.912302 -0.980686 -0.381164" rpy="-1.680665 -0.247050 2.329115" />
  </joint>
  <link name="mid_left_right_camera_optical_frame"/>
  <joint name="mid_left_left_to_right_camera_optical_frame" type="fixed">
    <parent link="mid_left_left_camera_optical_frame" />
    <child link="mid_left_right_camera_optical_frame" />
    <origin xyz="0.120223 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file mid-left.conf -->
  </joint>

  <!-- zed_camera/mid_center -->
  <link name="mid_center_left_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_fr_lidar_to_mid_center_left_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_fr/lidar" />
    <child link="mid_center_left_camera_optical_frame" />
    <origin xyz="0.841879473218738 -0.20883561124079453 -0.39611181508587195" rpy="-0.783122 -0.240062 2.334478" />
  </joint>
  <link name="mid_center_right_camera_optical_frame"/>
  <joint name="mid_center_left_to_right_camera_optical_frame" type="fixed">
    <parent link="mid_center_left_camera_optical_frame" />
    <child link="mid_center_right_camera_optical_frame" />
    <origin xyz="0.120098 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file mid-center.conf -->
  </joint>

  <!-- zed_camera/mid_right -->
  <link name="mid_right_left_camera_optical_frame"/>
  <joint name="mid_right_right_to_left_camera_optical_frame" type="fixed">
    <parent link="mid_right_right_camera_optical_frame" />
    <child link="mid_right_left_camera_optical_frame" />
    <origin xyz="-0.120143 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file mid-right.conf -->
  </joint>
  <link name="mid_right_right_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_fr_lidar_to_mid_right_right_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_fr/lidar" />
    <child link="mid_right_right_camera_optical_frame" />
    <origin xyz="0.853479 0.949437 -0.424602" rpy="-1.671673 0.246823 0.820154" />
  </joint>

  <!-- zed_camera/rear_left -->
  <link name="rear_left_left_camera_optical_frame"/>
  <joint name="rear_left_right_to_left_camera_optical_frame" type="fixed">
    <parent link="rear_left_right_camera_optical_frame" />
    <child link="rear_left_left_camera_optical_frame" />
    <origin xyz="-0.120045 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file rear-left.conf -->
  </joint>
  <link name="rear_left_right_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_rl_lidar_to_rear_left_right_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_rl/lidar" />
    <child link="rear_left_right_camera_optical_frame" />
    <origin xyz="0.029473 0.072925 -0.138551" rpy="-1.576319 0.002965 1.590596" />
  </joint>

  <!-- zed_camera/rear_center -->
  <link name="rear_center_left_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_rr_lidar_to_rear_center_left_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_rr/lidar" />
    <child link="rear_center_left_camera_optical_frame" />
    <origin xyz="0.397390 0.507360 -0.110427" rpy="-1.325054 0.236838 0.823929" />
  </joint>
  <link name="rear_center_right_camera_optical_frame"/>
  <joint name="rear_center_left_to_right_camera_optical_frame" type="fixed">
    <parent link="rear_center_left_camera_optical_frame" />
    <child link="rear_center_right_camera_optical_frame" />
    <origin xyz="0.120084 0 0" rpy="0 0 0" /> <!-- from StereoLabs calibration file rear-center.conf -->
  </joint>

  <!-- zed_camera/rear_right -->
  <link name="rear_right_left_camera_optical_frame"/>
  <joint name="joint_drivers_ouster_lidar_rr_lidar_to_rear_right_left_camera_optical_frame" type="fixed">
    <parent link="drivers/ouster_lidar_rr/lidar" />
    <child link="rear_right_left_camera_optical_frame" />
    <origin xyz="0.021656 -0.058758 -0.135281" rpy="-1.583717 -0.001725 1.570610" />
  </joint>
  <link name="rear_right_right_camera_optical_frame"/>
  <joint name="rear_right_left_to_right_camera_optical_frame" type="fixed">
